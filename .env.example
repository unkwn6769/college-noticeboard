# Local development only. Never commit real secrets.
DATABASE_URL=postgresql://...
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
ADMIN_GOOGLE_CLIENT_ID=replace-with-google-client-id
ADMIN_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ADMIN_GOOGLE_REDIRECT_URI=http://localhost:3001/api/admin/auth/google/callback
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
DRIVE_ACCOUNT_GOOGLE_CLIENT_ID=replace-with-google-client-id
DRIVE_ACCOUNT_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
DRIVE_ACCOUNT_GOOGLE_REDIRECT_URI=http://localhost:3001/api/admin/accounts/google/callback
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_DRIVE_HTTP2=true
DB_POOL_MAX=12
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=15000
DB_MAX_LIFETIME_SECONDS=300
MIGRATION_MIN_WORKERS=4
MIGRATION_MAX_WORKERS=64
MIGRATION_MAX_ITEMS_PER_RUN=0
MIGRATION_SERVER_SIDE_COPY=true
MIGRATION_SERVER_SIDE_COPY_TEMPORARY_WRITER=true
MIGRATION_RECONCILIATION_RETRY_DELAY_MS=2000
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=ghp_replace_with_pat_or_github_app_token
MIGRATION_GITHUB_WORKFLOW=migrations.yml

MIGRATION_DRIVE_OPERATION_TIMEOUT_MS=120000
