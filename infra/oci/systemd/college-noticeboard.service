[Unit]
Description=College Noticeboard Next.js application
After=network.target postgresql.service srv-noticeboard.mount
Requires=postgresql.service

[Service]
Type=simple
User=noticeboard
Group=noticeboard
WorkingDirectory=/opt/college-noticeboard
Environment=NODE_ENV=production
EnvironmentFile=/etc/college-noticeboard.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/noticeboard

[Install]
WantedBy=multi-user.target
