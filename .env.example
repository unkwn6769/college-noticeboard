NODE_ENV=development
DATABASE_URL=postgresql://college_noticeboard_app:change-me@127.0.0.1:5432/college_noticeboard
NOTICEBOARD_STORAGE_ROOT=/srv/noticeboard
# Read-only mount of \\10.24.14.231\noticeboards. Never point this at storage root.
LEGACY_NOTICEBOARD_ROOT=/mnt/legacy-noticeboards/noticeboards
LEGACY_NOTICEBOARD_SOURCE=filesystem
LEGACY_NOTICEBOARD_HTTP_ROOT=http://10.24.14.231/noticeboards/
LEGACY_NOTICEBOARD_HTTP_TIMEOUT_MS=15000
LEGACY_NOTICEBOARD_HTTP_MAX_RESPONSE_BYTES=1073741824
LEGACY_NOTICEBOARD_HTTP_CONCURRENCY=4
PG_POOL_MAX=8
MAX_UPLOAD_BYTES=536870912
LARGE_UPLOAD_BYTES=52428800
STORAGE_RESERVE_BYTES=2147483648
STAGING_RETENTION_HOURS=6
QUARANTINE_RETENTION_DAYS=7
SESSION_TTL_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-production
ADMIN_NAME=Noticeboard Owner
DB_BACKUP_RETENTION_DAYS=14
